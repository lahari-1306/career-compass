# ====================================================
# CareerCompass Production Environment Configuration
# ====================================================

# 1. Database Persistence Configuration
# -------------------------------------
# Option A (Recommended for Production / Render / Supabase / Neon / Cloud):
# Provide a PostgreSQL connection string. When set, CareerCompass automatically uses
# PostgreSQL with full table auto-creation, SSL support, and permanent persistence.
# Example: postgresql://career_user:password123@ep-cool-db-12345.render.com/career_compass_db
DATABASE_URL=

# Option B (Persistent SQLite):
# If DATABASE_URL is not set, CareerCompass uses SQLite in WAL mode.
# On cloud platforms with persistent disks (e.g. Render Persistent Disk mounted at /var/data),
# specify the full path to ensure data survives restarts:
# Example: /var/data/career_compass.db
DATABASE_PATH=data/career_compass.db

# Path to the data directory containing master notifications & learning resources
DATA_DIR=data

# 2. Server & Security Configuration
# -----------------------------------
SECRET_KEY=change-to-a-strong-random-secret-key-in-production
PORT=5000
FLASK_ENV=production

# Application Base URL (Render external URL or custom domain)
# Automatically detected from RENDER_EXTERNAL_URL if deployed on Render.
APP_BASE_URL=https://career-compass.onrender.com

# 3. SMTP Email Delivery Service (Password Reset & Radar Alerts)
# -------------------------------------------------------------
# CareerCompass uses standard SMTP for real-time dispatch of password reset links,
# welcome emails, and Radar deadline alerts.
#
# Examples by Provider:
#
# A) Gmail (Recommended for personal/testing):
#    SMTP_HOST=smtp.gmail.com
#    SMTP_PORT=587
#    SMTP_USERNAME=your.email@gmail.com
#    SMTP_PASSWORD=your_16_char_google_app_password
#    MAIL_FROM="CareerCompass <your.email@gmail.com>"
#    MAIL_USE_TLS=true
#
# B) Brevo (Formerly Sendinblue - Free 300 emails/day):
#    SMTP_HOST=smtp-relay.brevo.com
#    SMTP_PORT=587
#    SMTP_USERNAME=your_brevo_login_email
#    SMTP_PASSWORD=your_brevo_smtp_key
#    MAIL_FROM="CareerCompass <noreply@yourdomain.com>"
#    MAIL_USE_TLS=true
#
# C) SendGrid / Resend:
#    SMTP_HOST=smtp.sendgrid.net  (or smtp.resend.com)
#    SMTP_PORT=587
#    SMTP_USERNAME=apikey  (or resend)
#    SMTP_PASSWORD=your_api_key_secret
#    MAIL_FROM="CareerCompass <noreply@yourdomain.com>"
#    MAIL_USE_TLS=true
#
# NOTE: If SMTP is not configured in local/dev environments, CareerCompass generates
# a secure time-limited reset token, logs the rendered email to data/email_logs.json,
# and displays an instant "Proceed to Reset Password" direct link so you are never blocked.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
MAIL_FROM="CareerCompass <noreply@careercompass.org>"
MAIL_USE_TLS=true

# 4. AI Career Guide Configuration (Optional)
# -------------------------------------------
# If provided, enables live Gemini AI responses.
# If omitted, CareerCompass operates on the built-in Verified Offline Knowledge Engine.
GEMINI_API_KEY=
